# ── Required ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/crescendo?sslmode=require
JWT_SECRET=change-me-to-a-random-string-min-32-chars
PORT=3000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Frontend URL added to CORS allow-list (localhost:3000 and :5173 always allowed)
# APP_URL=https://your-frontend.vercel.app

# ── Google OAuth ──────────────────────────────────────────────────────────────
#GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Stripe (optional — set STRIPE_ENABLED=true to require keys) ──────────────
# STRIPE_ENABLED=true
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Spotify (optional — used for album velocity scoring) ─────────────────────
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
